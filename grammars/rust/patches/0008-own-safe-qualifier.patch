+================================================================================
+Pymtheg patch 0008: safe qualifier in an unsafe extern block
+================================================================================
+
+unsafe extern "C" {
+    pub safe fn abs(x: i32) -> i32;
+    pub safe static errno: i32;
+}
+
+---
+
+(source_file
+  (foreign_mod_item
+    (extern_modifier
+      (string_literal
+        (string_content)))
+    body: (declaration_list
+      (function_signature_item
+        (visibility_modifier)
+        name: (identifier)
+        parameters: (parameters
+          (parameter
+            pattern: (identifier)
+            type: (primitive_type)))
+        return_type: (primitive_type))
+      (static_item
+        (visibility_modifier)
+        name: (identifier)
+        type: (primitive_type)))))
+
+================================================================================
+Pymtheg patch 0008: safe stays an ordinary identifier
+================================================================================
+
+fn f(safe: bool) -> bool {
+    safe
+}
+
+---
+
+(source_file
+  (function_item
+    name: (identifier)
+    parameters: (parameters
+      (parameter
+        pattern: (identifier)
+        type: (primitive_type)))
+    return_type: (primitive_type)
+    body: (block
+      (identifier))))
+
