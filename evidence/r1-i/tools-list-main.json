  {
   "name": "graph_result",
   "description": "Read/poll/cancel a code_graph job. Default answer includes counts, failure names and certainty previews. Follow nextOffset for immutable pages; sections symbols/links/possible_callers/frontiers/candidates/failed_files/stale_files/warnings/modules/legend/detail. Filter candidates by ref=link ref; detail retrieves exact stored JSON in character pages (limit <=16384). Reason codes expand in legend. Core truncation requires a narrower/new query, not more pages. wait=true waits without blocking other tools and emits progress if the client supplied a progressToken.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
     },
     "action": {
      "default": "read",
      "type": "string",
      "enum": [
       "read",
       "cancel"
      ]
     },
     "section": {
      "default": "answer",
      "type": "string",
      "enum": [
       "answer",
       "symbols",
       "links",
       "possible_callers",
       "frontiers",
       "candidates",
       "failed_files",
       "stale_files",
       "warnings",
       "modules",
       "legend",
       "detail"
      ]
     },
     "ref": {
      "type": "string",
      "maxLength": 8192
     },
     "offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
     },
     "wait": {
      "default": false,
      "type": "boolean"
     }
    },
    "required": [
     "jobId"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "openWorldHint": false
   }
  },
