{
 "tools": [
  {
   "name": "check_design",
   "description": "Run local type, outcome, effect, ownership, cost and rule-copy checks on the entry, its imports and discovered callers by default; checkScope entry restricts to the import closure and project explicitly checks all selected source files. Optional buffers test edits without saving them. Returns an immutable run ID and a bounded first page of finding reasons/hints. Use read_run for full findings and evidence. A design problem is a finding, not a tool failure.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
     },
     "buffers": {
      "type": "object",
      "propertyNames": {
       "type": "string",
       "minLength": 1,
       "maxLength": 4096
      },
      "additionalProperties": {
       "type": "string",
       "maxLength": 2097152
      }
     },
     "checkScope": {
      "default": "related",
      "type": "string",
      "enum": [
       "related",
       "project",
       "entry"
      ]
     }
    },
    "required": [
     "file"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
   }
  },
  {
   "name": "code_graph",
   "description": "Ask about Go/Rust/TypeScript code: search first, then symbol/callers/callees/impact/path/file. Selectors accept stable symbol refs, exact names, qualified names or path:line[:column]. Queries automatically sync changed content unless noSync. Returns the first result page inline when finished within 5 seconds (default wait:true); otherwise returns a job with progress for graph_result. Use wait:false to return a handle immediately. section chooses the first result page; later pages use graph_result. index explicitly updates all modules; status is read-only. Cold indexing can be long: poll the job for deterministic file/phase progress. Never treat possible/unresolved calls as definite.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "index",
       "status",
       "search",
       "symbol",
       "callers",
       "callees",
       "path",
       "impact",
       "file"
      ]
     },
     "wait": {
      "default": true,
      "type": "boolean"
     },
     "section": {
      "default": "answer",
      "type": "string",
      "enum": [
       "answer",
       "symbols",
       "links",
       "possible_callers",
       "frontiers",
       "candidates",
       "failed_files",
       "stale_files",
       "warnings",
       "modules",
       "legend"
      ]
     },
     "query": {
      "type": "string",
      "maxLength": 4096
     },
     "to": {
      "type": "string",
      "maxLength": 4096
     },
     "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
     },
     "depth": {
      "default": 5,
      "type": "integer",
      "minimum": 0,
      "maximum": 100
     },
     "noSync": {
      "default": false,
      "type": "boolean"
     },
     "caseSensitive": {
      "default": false,
      "type": "boolean"
     },
     "includePossible": {
      "default": false,
      "type": "boolean"
     }
    },
    "required": [
     "action"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "openWorldHint": false
   }
  },
  {
   "name": "compare_implementation",
   "description": "Compare one retained plan/declaration link against its exact reviewed checkpoint. Shows bounded source diff, paged relationship counts and explicit missing-baseline/coverage limits. Read-only; never acknowledges changes. Use link_implementation with this response's current revision, plan hash, observation ID and retained note only after explicit review to accept the current pair.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "planRevision": {
      "type": "string",
      "minLength": 1
     },
     "codeRevision": {
      "type": "string",
      "minLength": 1
     },
     "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
     },
     "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
     },
     "offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
     }
    },
    "required": [
     "planRevision",
     "codeRevision",
     "planId",
     "nodeId"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
   }
  },
  {
   "name": "design_interface",
   "description": "Page callable IDs (symbols) or visible type metadata (types) using query/offset/limit, inspect one type or callable interface, preview signature or standalone type edits that preserve handwritten bodies, edit an existing resource lifecycle (resource/preview_resource) or operation rules and symbolic costs (operation/preview_operation), and create new component/operation/type/resource/machine declarations. Machines use finite Bool/Nat/Int states, events and safety invariants; blank expressions stay unknown. Use creation for the target sourceHash. creation_types searches project type metadata; retain file, symbolId and sourceHash in typeSelections when calling create with a structured edit. refresh rebuilds the type list; pages require inventoryId. Preview checks selected imports and refuses changed sources. Preview only: returns source changes and affected consumers; never saves files.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "symbols",
       "types",
       "type",
       "describe",
       "preview",
       "preview_type",
       "resource",
       "preview_resource",
       "operation",
       "preview_operation",
       "creation",
       "creation_types",
       "create",
       "resume"
      ]
     },
     "file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
     },
     "query": {
      "default": "",
      "type": "string",
      "maxLength": 200
     },
     "offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
     },
     "runId": {
      "type": "string"
     },
     "symbolId": {
      "type": "string"
     },
     "sourceHash": {
      "type": "string"
     },
     "typeSelections": {
      "maxItems": 128,
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "symbolId": {
         "type": "string",
         "minLength": 1,
         "maxLength": 8192
        },
        "file": {
         "type": "string",
         "minLength": 1,
         "maxLength": 4096
        },
        "sourceHash": {
         "type": "string",
         "pattern": "^[a-f0-9]{64}$"
        },
        "name": {
         "type": "string",
         "maxLength": 120
        },
        "kind": {
         "type": "string",
         "enum": [
          "record",
          "choice",
          "resource"
         ]
        }
       },
       "required": [
        "symbolId",
        "file",
        "sourceHash"
       ],
       "additionalProperties": false
      }
     },
     "typeKind": {
      "type": "string",
      "enum": [
       "all",
       "record",
       "choice",
       "resource"
      ]
     },
     "declarationKind": {
      "description": "With action creation, return the same editable starting form as Studio for this kind.",
      "type": "string",
      "enum": [
       "component",
       "operation",
       "type",
       "resource",
       "machine"
      ]
     },
     "refresh": {
      "type": "boolean"
     },
     "inventoryId": {
      "type": "string"
     },
     "directory": {
      "type": "string"
     },
     "edit": {
      "$ref": "#/$defs/__schema0"
     },
     "draft": {
      "$ref": "#/$defs/__schema1"
     }
    },
    "required": [
     "action",
     "runId"
    ],
    "additionalProperties": false,
    "$defs": {
     "__schema0": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       },
       {
        "type": "null"
       },
       {
        "type": "array",
        "items": {
         "$ref": "#/$defs/__schema0"
        }
       },
       {
        "type": "object",
        "propertyNames": {
         "type": "string"
        },
        "additionalProperties": {
         "$ref": "#/$defs/__schema0"
        }
       }
      ]
     },
     "__schema1": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       },
       {
        "type": "null"
       },
       {
        "type": "array",
        "items": {
         "$ref": "#/$defs/__schema1"
        }
       },
       {
        "type": "object",
        "propertyNames": {
         "type": "string"
        },
        "additionalProperties": {
         "$ref": "#/$defs/__schema1"
        }
       }
      ]
     }
    }
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
   }
