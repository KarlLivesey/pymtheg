  {
   "name": "emit_implementation_check",
   "description": "Generate a separate compiler-check file for a named handwritten implementation and its generated contracts. TypeScript checks exact inputs; Go checks pointer method signatures; Rust checks its trait bound. Include this file in the normal build. No files are written and no compiler result is claimed.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "target": {
      "type": "string",
      "enum": [
       "typescript",
       "rust",
       "go"
      ]
     },
     "contractsModule": {
      "description": "Generated contracts module for TypeScript/Rust. Omit for a same-package Go check.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
     },
     "implementationModule": {
      "description": "TypeScript implementation module. Omit for Rust/Go.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
     },
     "implementationType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
     },
     "runId": {
      "type": "string"
     }
    },
    "required": [
     "target",
     "implementationType",
     "runId"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
   }
  },
  {
   "name": "emit_scaffold",
   "description": "Generate TypeScript, Rust or Go types and function signatures with fail-fast stubs by default (or explicitly empty bodies) from an existing checked run. Does not write files or invent unresolved contracts. This is incomplete scaffolding, not working or verified application code. Large outputs return an emissionId; retrieve exact text with read_scaffold.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "runId": {
      "type": "string"
     },
     "target": {
      "default": "typescript",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,39}$"
     },
     "body": {
      "default": "fail-fast",
      "type": "string",
      "enum": [
       "fail-fast",
       "empty"
      ]
     },
     "mode": {
      "default": "stubs",
      "type": "string",
      "enum": [
       "stubs",
       "contracts"
      ]
     }
    },
    "required": [
     "runId"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
   }
